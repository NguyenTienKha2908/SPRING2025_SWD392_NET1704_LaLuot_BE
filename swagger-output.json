  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "abc@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "***"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Signup": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "abc@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "***"
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      },
      "ResetPassword": {
        "type": "object",
        "properties": {
          "newPassword": {
            "type": "string",
            "example": "***"
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "GetAllUsers": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "example": 10
          },
          "sort": {
            "type": "string",
            "example": "ctime"
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "filter": {
            "type": "object",
            "properties": {
              "isDeleted": {
                "type": "boolean",
                "example": false
              }
            }
          },
          "select": {
            "type": "string",
            "example": "fullName email role"
          }
        }
      },
      "CreateUser": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "abc@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "***"
          },
          "role": {
            "type": "number",
            "example": 2
          }
        },
        "required": [
          "fullName",
          "email",
          "password"
        ]
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
